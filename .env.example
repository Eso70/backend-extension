NODE_ENV=development
PORT=3033
HOST=127.0.0.1
ADMIN_PATH=/replace-with-a-long-private-admin-path
ADMIN_SESSION_HOURS=8
USER_SESSION_DAYS=1

# Google OAuth administrator login
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3033/replace-with-a-long-private-admin-path/google/callback
GOOGLE_USER_REDIRECT_URI=http://127.0.0.1:3033/api/v1/auth/google/callback
ADMIN_GOOGLE_EMAILS=admin@example.com

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tiktok_extension
DB_USER=postgres
DB_PASSWORD=change-this-db-password
DB_SSL=false
DB_POOL_SIZE=10

# Bootstrap origin used only when the database allowlist is empty.
# Leave empty for unrestricted local development; production requires one origin.
# Manage additional extension IDs from the administrator dashboard.
ALLOWED_EXTENSION_ORIGINS=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_CSRF_SECRET=replace-with-a-random-secret
ADMIN_SESSION_SECRET=replace-with-a-different-random-secret
