NODE_ENV=production
HOST=127.0.0.1
PORT=3033

# Use a new private path containing 16-100 letters, numbers, dashes, or underscores.
ADMIN_PATH=/replace-with-a-long-random-private-admin-path
ADMIN_SESSION_HOURS=8
USER_SESSION_DAYS=30

# Google OAuth Web application credentials.
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://extension.sponsor.krd/replace-with-a-long-random-private-admin-path/google/callback
GOOGLE_USER_REDIRECT_URI=https://extension.sponsor.krd/api/v1/auth/google/callback
ADMIN_GOOGLE_EMAILS=admin@yourdomain.com

# PostgreSQL. Keep DB_SSL=false when PostgreSQL is on the same VPS.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tiktok_extension
DB_USER=tiktok_extension
DB_PASSWORD=replace-with-a-strong-unique-database-password
DB_SSL=false
DB_POOL_SIZE=10

# The exact ID Chrome assigns to the published or unpacked production extension.
# Separate multiple origins with commas only when intentionally supporting more than one build.
ALLOWED_EXTENSION_ORIGINS=chrome-extension://replace-with-your-32-character-extension-id

# Generate each secret separately:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_CSRF_SECRET=replace-with-a-random-secret
ADMIN_SESSION_SECRET=replace-with-a-different-random-secret
